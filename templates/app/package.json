{
  "name": "nexus-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "bun run typecheck && bun run test && cf deploy",
    "typecheck": "tsr generate && cf workers types && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "auth generate --config src/lib/auth.cli.ts --output db/auth-schema.ts --yes",
    "db:migrate": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --local --persist-to .cloudflare/state --dir db/migrations"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.9",
    "@cloudflare/vitest-plugin": "1.4.12",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.46",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "auth": "1.7.15",
    "cf": "1.0.0-beta.26",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
