{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":separatePatchReleases"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Review the tested scaffold stack together",
      "groupName": "Nexus stack",
      "matchFileNames": [
        "templates/app/package.json"
      ],
      "automerge": false
    },
    {
      "description": "Review CLI toolchain updates",
      "groupName": "Nexus tooling",
      "matchFileNames": [
        "package.json",
        "packages/core/package.json",
        "packages/cli/package.json"
      ],
      "automerge": false
    }
  ],
  "schedule": [
    "before 10am on monday"
  ],
  "timezone": "UTC",
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "youming-bot"
  ],
  "reviewers": [
    "youming-bot"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "postUpdateOptions": [],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 10am on monday"
    ]
  },
  "ignorePaths": [
    "tests/fixtures/**"
  ]
}
